{
  "name": "blog-api",
  "version": "1.0.0",
  "description": "API REST de authors, posts y comments con Node.js, Express y PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "test": "jest",
    "db:setup": "node scripts/db.js setup",
    "db:seed": "node scripts/db.js seed",
    "db:reset": "node scripts/db.js seed --force",
    "db:init": "node scripts/db.js setup && node scripts/db.js seed",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test:coverage": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
